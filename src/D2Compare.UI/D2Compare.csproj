<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets/compare_yRb_icon.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <Version>2.1.2-rc.4</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.2" />
    <PackageReference Include="ProDataGrid" Version="12.1.5" />
    <PackageReference Include="TablerIcons.Avalonia" Version="3.44.0" />
  </ItemGroup>

  <!-- Debug-only XAML hot reload. Loader must match the Avalonia version: HotAvalonia bundles an Avalonia 11 one -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.6" PrivateAssets="All" Publish="True" />
    <PackageReference Include="HotAvalonia" Version="3.1.5" PrivateAssets="All" Publish="True" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D2Compare.Core\D2Compare.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../TXT/**/*.txt" CopyToOutputDirectory="Always" LinkBase="TXT" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!-- SkiaSharp/HarfBuzzSharp native packages ship .pdb files that DebugType=none doesn't cover -->
  <Target Name="RemovePublishPdbs" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish
        Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb'"
      />
    </ItemGroup>
  </Target>
</Project>
