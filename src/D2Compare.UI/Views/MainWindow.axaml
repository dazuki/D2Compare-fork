<Window
  x:Class="D2Compare.Views.MainWindow"
  xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:collections="using:Avalonia.Collections"
  xmlns:controls="using:D2Compare.Controls"
  xmlns:models="using:D2Compare.Core.Models"
  xmlns:ti="using:TablerIcons"
  xmlns:vm="using:D2Compare.ViewModels"
  Title="{Binding AppVersion, StringFormat='D2Compare-fork v{0} (fork by dazuki)'}"
  MinWidth="1110"
  MinHeight="380"
  x:DataType="vm:MainViewModel"
  Background="{DynamicResource WindowBackgroundBrush}"
  Icon="/Assets/compare_yRb_icon.ico"
>
  <Window.Resources>
    <!--  Conditional formatting themes for the Change column  -->
    <ControlTheme
      x:Key="AddedCellTheme"
      TargetType="DataGridCell"
      BasedOn="{StaticResource {x:Type DataGridCell}}"
    >
      <Setter Property="Foreground" Value="{DynamicResource StatAddedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </ControlTheme>
    <ControlTheme
      x:Key="RemovedCellTheme"
      TargetType="DataGridCell"
      BasedOn="{StaticResource {x:Type DataGridCell}}"
    >
      <Setter Property="Foreground" Value="{DynamicResource StatRemovedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </ControlTheme>
    <ControlTheme
      x:Key="ChangedCellTheme"
      TargetType="DataGridCell"
      BasedOn="{StaticResource {x:Type DataGridCell}}"
    >
      <Setter Property="Foreground" Value="{DynamicResource StatChangedBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </ControlTheme>
    <ControlTheme
      x:Key="MutedCellTheme"
      TargetType="DataGridCell"
      BasedOn="{StaticResource {x:Type DataGridCell}}"
    >
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </ControlTheme>
    <!--
      Copy of ProDataGrid's DataGridRowGroupHeader template (Themes/Generic.xaml, v12.1.5)
      with the key text swapped for a ContentControl: file groups (FileSummary keys) show
      the name plus colored counts, data-row groups (string keys) show plain text.
    -->
    <ControlTheme
      x:Key="DiffRowGroupHeaderTheme"
      TargetType="DataGridRowGroupHeader"
      BasedOn="{StaticResource {x:Type DataGridRowGroupHeader}}"
    >
      <Setter Property="Template">
        <ControlTemplate x:DataType="collections:DataGridCollectionViewGroup">
          <DataGridFrozenGrid
            Name="PART_Root"
            MinHeight="{TemplateBinding MinHeight}"
            Background="{TemplateBinding Background}"
            ColumnDefinitions="Auto,Auto,Auto,Auto,*"
            RowDefinitions="*,Auto,Auto"
          >
            <Rectangle Name="PART_IndentSpacer" Grid.Column="1" />
            <ToggleButton
              Name="PART_ExpanderButton"
              Grid.Column="2"
              Margin="{DynamicResource DataGridRowGroupHeaderExpanderMargin}"
              VerticalAlignment="{TemplateBinding ContentVerticalAlignment}"
              Theme="{StaticResource DataGridRowGroupExpanderButtonTheme}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}"
              Background="{TemplateBinding Background}"
              CornerRadius="{TemplateBinding CornerRadius}"
              IsTabStop="False"
              Foreground="{TemplateBinding Foreground}"
            />

            <StackPanel
              Grid.Column="3"
              Margin="{DynamicResource DataGridRowGroupHeaderContentMargin}"
              VerticalAlignment="{TemplateBinding ContentVerticalAlignment}"
              Orientation="Horizontal"
            >
              <TextBlock
                Name="PART_PropertyNameElement"
                Margin="{DynamicResource DataGridRowGroupHeaderTextMargin}"
                IsVisible="{TemplateBinding IsPropertyNameVisible}"
                Foreground="{TemplateBinding Foreground}"
              />
              <ContentControl
                Margin="{DynamicResource DataGridRowGroupHeaderTextMargin}"
                VerticalAlignment="Center"
                Content="{Binding Key}"
                Foreground="{TemplateBinding Foreground}"
              >
                <!--  Same size for both levels; only file names are SemiBold so they lead  -->
                <ContentControl.Styles>
                  <Style Selector="TextBlock">
                    <Setter
                      Property="FontSize"
                      Value="{DynamicResource DataGridRowGroupHeaderFontSize}"
                    />
                    <Setter Property="FontWeight" Value="Normal" />
                  </Style>
                  <Style Selector="StackPanel.file > TextBlock">
                    <Setter Property="FontWeight" Value="SemiBold" />
                  </Style>
                </ContentControl.Styles>
                <ContentControl.DataTemplates>
                  <!--  Values: "~changed +new", same order as the panel header  -->
                  <DataTemplate DataType="models:ValueFileSummary">
                    <StackPanel Classes="file" Orientation="Horizontal" Spacing="8">
                      <TextBlock
                        Foreground="{DynamicResource FileNameBrush}"
                        Text="{Binding FileName}"
                      />
                      <TextBlock
                        Foreground="{DynamicResource StatChangedBrush}"
                        IsVisible="{Binding Changed, Converter={StaticResource IntToBool}}"
                        Text="{Binding Changed, StringFormat='~{0}'}"
                      />
                      <TextBlock
                        Foreground="{DynamicResource StatAddedBrush}"
                        IsVisible="{Binding Added, Converter={StaticResource IntToBool}}"
                        Text="{Binding Added, StringFormat='+{0}'}"
                      />
                    </StackPanel>
                  </DataTemplate>
                  <DataTemplate DataType="models:FileSummary">
                    <StackPanel Classes="file" Orientation="Horizontal" Spacing="8">
                      <TextBlock
                        Foreground="{DynamicResource FileNameBrush}"
                        Text="{Binding FileName}"
                      />
                      <TextBlock
                        Foreground="{DynamicResource StatAddedBrush}"
                        IsVisible="{Binding Added, Converter={StaticResource IntToBool}}"
                        Text="{Binding Added, StringFormat='+{0}'}"
                      />
                      <TextBlock
                        Foreground="{DynamicResource StatRemovedBrush}"
                        IsVisible="{Binding Removed, Converter={StaticResource IntToBool}}"
                        Text="{Binding Removed, StringFormat='-{0}'}"
                      />
                      <TextBlock
                        Foreground="{DynamicResource StatChangedBrush}"
                        IsVisible="{Binding Changed, Converter={StaticResource IntToBool}}"
                        Text="{Binding Changed, StringFormat='~{0}'}"
                      />
                    </StackPanel>
                  </DataTemplate>
                </ContentControl.DataTemplates>
              </ContentControl>
              <TextBlock
                Name="PART_ItemCountElement"
                Margin="{DynamicResource DataGridRowGroupHeaderTextMargin}"
                IsVisible="{TemplateBinding IsItemCountVisible}"
                Foreground="{TemplateBinding Foreground}"
              />
            </StackPanel>

            <Rectangle
              x:Name="CurrencyVisual"
              Grid.ColumnSpan="5"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Fill="Transparent"
              IsHitTestVisible="False"
              IsVisible="False"
              Stroke="{DynamicResource DataGridCurrencyVisualPrimaryBrush}"
              StrokeThickness="{DynamicResource DataGridRowGroupCurrencyStrokeThickness}"
            />
            <Grid
              x:Name="FocusVisual"
              Grid.ColumnSpan="5"
              IsHitTestVisible="False"
              IsVisible="False"
            >
              <Rectangle
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Fill="Transparent"
                IsHitTestVisible="False"
                Stroke="{DynamicResource DataGridCellFocusVisualPrimaryBrush}"
                StrokeThickness="{DynamicResource DataGridRowGroupFocusPrimaryStrokeThickness}"
              />
              <Rectangle
                Margin="{DynamicResource DataGridRowGroupFocusSecondaryMargin}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Fill="Transparent"
                IsHitTestVisible="False"
                Stroke="{DynamicResource DataGridCellFocusVisualSecondaryBrush}"
                StrokeThickness="{DynamicResource DataGridRowGroupFocusSecondaryStrokeThickness}"
              />
            </Grid>

            <DataGridRowHeader
              Name="PART_RowHeader"
              Grid.RowSpan="3"
              DataGridFrozenGrid.IsFrozen="True"
            />

            <DataGridSummaryRow
              Name="PART_SummaryRow"
              Grid.Row="1"
              Grid.ColumnSpan="5"
              IsVisible="False"
            />

            <Rectangle
              x:Name="PART_BottomGridLine"
              Grid.Row="2"
              Grid.ColumnSpan="5"
              Height="{DynamicResource DataGridRowGroupBottomGridLineHeight}"
            />
          </DataGridFrozenGrid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="DataGrid.diff">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="SelectionMode" Value="Extended" />
      <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
      <Setter Property="CanUserResizeColumns" Value="True" />
      <Setter Property="CanUserSortColumns" Value="True" />
      <Setter Property="AreRowGroupHeadersFrozen" Value="True" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RowGroupTheme" Value="{StaticResource DiffRowGroupHeaderTheme}" />
    </Style>
    <Style Selector="DataGrid.diff DataGridColumnHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGrid.diff DataGridRowGroupHeader">
      <Setter Property="IsPropertyNameVisible" Value="False" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!--  Top Control Area  -->
    <Grid Grid.Row="0" Margin="10,10,10,10" ColumnDefinitions="*,Auto">
      <!--  Left: Version/File Selection  -->
      <Grid
        Grid.Column="0"
        Margin="0,0,20,0"
        ColumnDefinitions="Auto,*,Auto"
        ColumnSpacing="10"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
        RowSpacing="6"
      >
        <StackPanel
          Grid.Row="0"
          Grid.Column="0"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="6"
        >
          <ti:TablerIcon
            Width="18"
            Height="18"
            Brush="{DynamicResource IconForegroundBrush}"
            Icon="IconFileExport"
            StrokeWidth="2"
          />
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Source" />
        </StackPanel>
        <ComboBox
          Grid.Row="0"
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          ItemsSource="{Binding SourceVersions}"
          SelectedIndex="{Binding SelectedSourceIndex}"
        />
        <Button
          Grid.Row="0"
          Grid.Column="2"
          Padding="6,4"
          Command="{Binding BrowseSourceCustomCommand}"
          IsVisible="{Binding IsSourceCustom}"
        >
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ti:TablerIcon
              Width="16"
              Height="16"
              Brush="{DynamicResource IconForegroundBrush}"
              Icon="IconFolderOpen"
              StrokeWidth="2"
            />
            <TextBlock VerticalAlignment="Center" Text="Browse" />
          </StackPanel>
        </Button>

        <StackPanel
          Grid.Row="1"
          Grid.Column="0"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="6"
        >
          <ti:TablerIcon
            Width="18"
            Height="18"
            Brush="{DynamicResource IconForegroundBrush}"
            Icon="IconFileImport"
            StrokeWidth="2"
          />
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Target" />
        </StackPanel>
        <ComboBox
          Grid.Row="1"
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          ItemsSource="{Binding TargetVersions}"
          SelectedIndex="{Binding SelectedTargetIndex}"
        />
        <Button
          Grid.Row="1"
          Grid.Column="2"
          Padding="6,4"
          Command="{Binding BrowseTargetCustomCommand}"
          IsVisible="{Binding IsTargetCustom}"
        >
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ti:TablerIcon
              Width="16"
              Height="16"
              Brush="{DynamicResource IconForegroundBrush}"
              Icon="IconFolderOpen"
              StrokeWidth="2"
            />
            <TextBlock VerticalAlignment="Center" Text="Browse" />
          </StackPanel>
        </Button>

        <StackPanel
          Grid.Row="2"
          Grid.Column="0"
          VerticalAlignment="Center"
          Orientation="Horizontal"
          Spacing="6"
        >
          <ti:TablerIcon
            Width="18"
            Height="18"
            Brush="{DynamicResource IconForegroundBrush}"
            Icon="IconFileText"
            StrokeWidth="2"
          />
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="File" />
        </StackPanel>
        <ComboBox
          Grid.Row="2"
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          ItemsSource="{Binding FileList}"
          SelectedIndex="{Binding SelectedFileIndex}"
        />

        <!--  Buttons row, aligned with dropdowns  -->
        <StackPanel
          Grid.Row="3"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          Orientation="Horizontal"
          Spacing="8"
        >
          <Button Padding="8,4" Command="{Binding OpenSourceFileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ti:TablerIcon
                Width="16"
                Height="16"
                Brush="{DynamicResource IconForegroundBrush}"
                Icon="IconFileExport"
                StrokeWidth="2"
              />
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Open Source File" />
            </StackPanel>
          </Button>
          <Button Padding="8,4" Command="{Binding OpenTargetFileCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ti:TablerIcon
                Width="16"
                Height="16"
                Brush="{DynamicResource IconForegroundBrush}"
                Icon="IconFileImport"
                StrokeWidth="2"
              />
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Open Target File" />
            </StackPanel>
          </Button>
          <Button Padding="8,4" Command="{Binding BatchLoadCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ti:TablerIcon
                Width="16"
                Height="16"
                Brush="{DynamicResource IconForegroundBrush}"
                Icon="IconFiles"
                StrokeWidth="2"
              />
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Display All" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource WarningBrush}"
                IsVisible="{Binding BatchReloadNeeded}"
                Text="(Reload Needed)"
              />
            </StackPanel>
          </Button>
          <TextBlock
            VerticalAlignment="Center"
            Foreground="{DynamicResource WarningBrush}"
            IsVisible="{Binding IncludeNewRows}"
            Text="Resource Heavy"
          />
        </StackPanel>

        <!--  Checkboxes row, aligned with dropdowns  -->
        <StackPanel
          Grid.Row="4"
          Grid.Column="1"
          Grid.ColumnSpan="2"
          Orientation="Horizontal"
          Spacing="16"
        >
          <CheckBox
            VerticalAlignment="Center"
            Content="Omit unchanged files"
            IsChecked="{Binding OmitUnchangedFiles}"
          />
          <CheckBox
            VerticalAlignment="Center"
            Content="Include new rows in value breakdown (slower)"
            IsChecked="{Binding IncludeNewRows}"
          />
          <CheckBox
            VerticalAlignment="Center"
            Content="Show only new rows"
            IsChecked="{Binding ShowOnlyNewRows}"
            IsEnabled="{Binding IncludeNewRows}"
          />
        </StackPanel>

        <!--  Convert to target: options + button  -->
        <StackPanel
          Grid.Row="5"
          Grid.Column="0"
          Grid.ColumnSpan="3"
          Margin="0,8,0,0"
          Orientation="Horizontal"
          Spacing="16"
        >
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Convert to target:" />
          <CheckBox
            VerticalAlignment="Center"
            Content="Columns"
            IsChecked="{Binding ConvertColumns}"
          />
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Rows:" />
          <StackPanel VerticalAlignment="Center" Orientation="Vertical" Spacing="2">
            <RadioButton
              Content="None"
              GroupName="RowConversionMode"
              IsChecked="{Binding IsRowModeNone}"
            />
            <RadioButton
              Content="Append original data at end"
              GroupName="RowConversionMode"
              IsChecked="{Binding IsRowModeAppendOriginal}"
            />
            <RadioButton
              Content="Append target data at end"
              GroupName="RowConversionMode"
              IsChecked="{Binding IsRowModeAppendTarget}"
            />
          </StackPanel>
          <Button Padding="8,4" Command="{Binding ConvertToTargetCommand}">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <ti:TablerIcon
                Width="16"
                Height="16"
                Brush="{DynamicResource IconForegroundBrush}"
                Icon="IconFileExport"
                StrokeWidth="2"
              />
              <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Convert all .txt to target..."
              />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <!--  Right: File Summary + Search  -->
      <StackPanel Grid.Column="1" MaxWidth="320" VerticalAlignment="Top" Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
            <ti:TablerIcon
              Width="18"
              Height="18"
              Brush="{DynamicResource IconForegroundBrush}"
              Icon="IconFolderSearch"
              StrokeWidth="2"
            />
            <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="File Summary" />
          </StackPanel>
          <Button
            Grid.Column="2"
            Padding="4"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Command="{Binding ToggleThemeCommand}"
          >
            <Panel>
              <ti:TablerIcon
                Width="20"
                Height="20"
                Brush="{DynamicResource IconForegroundBrush}"
                Icon="IconSunFilled"
                IsVisible="{Binding !IsDarkMode}"
                StrokeWidth="2"
              />
              <ti:TablerIcon
                Width="20"
                Height="20"
                Brush="{DynamicResource IconForegroundBrush}"
                Icon="IconMoonFilled"
                IsVisible="{Binding IsDarkMode}"
                StrokeWidth="2"
              />
            </Panel>
          </Button>
        </Grid>
        <Border
          MinWidth="280"
          MaxHeight="220"
          Padding="8"
          Background="{DynamicResource PanelBackgroundBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1"
        >
          <Panel>
            <controls:FormattedTextPresenter
              Document="{Binding FilesDocument}"
              FontFamily="{StaticResource MonoFont}"
            />
            <TextBlock
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              FontStyle="Italic"
              Foreground="{DynamicResource MutedBrush}"
              IsVisible="{Binding HasNoFileChanges}"
              Text="No changes..."
            />
          </Panel>
        </Border>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding SearchText}" PlaceholderText="Search Term(s)">
            <TextBox.KeyBindings>
              <KeyBinding Command="{Binding ExecuteSearchCommand}" Gesture="Enter" />
            </TextBox.KeyBindings>
            <TextBox.InnerLeftContent>
              <ti:TablerIcon
                Width="16"
                Height="16"
                Margin="6,0,0,0"
                VerticalAlignment="Center"
                Brush="{DynamicResource IconForegroundBrush}"
                Icon="IconSearch"
                Opacity="0.4"
                StrokeWidth="2"
              />
            </TextBox.InnerLeftContent>
          </TextBox>
          <Button
            Grid.Column="1"
            Padding="8,0"
            VerticalAlignment="Stretch"
            Command="{Binding ExecuteSearchCommand}"
            ToolTip.Tip="Search"
          >
            <ti:TablerIcon
              Width="16"
              Height="16"
              Brush="{DynamicResource IconForegroundBrush}"
              Icon="IconSearch"
              StrokeWidth="2"
            />
          </Button>
        </Grid>
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock
            Grid.Column="0"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Text="{Binding MatchLabel}"
          />
          <TextBlock
            Grid.Column="1"
            VerticalAlignment="Top"
            Classes.warning="{Binding IsStatusWarning}"
            Text="{Binding StatusText}"
            TextWrapping="Wrap"
          >
            <TextBlock.Styles>
              <Style Selector="TextBlock:not(.warning)">
                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
              </Style>
              <Style Selector="TextBlock.warning">
                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
              </Style>
            </TextBlock.Styles>
          </TextBlock>
        </Grid>
      </StackPanel>
    </Grid>

    <!--  Main Content: Three Panels  -->
    <Grid
      x:Name="PanelsGrid"
      Grid.Row="1"
      Margin="10,0,10,10"
      ColumnDefinitions="*,Auto,*,Auto,1.5*"
      RowDefinitions="Auto,*"
    >
      <!--  Column Headers  -->
      <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,4" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <ti:TablerIcon
            Width="18"
            Height="18"
            Brush="{DynamicResource IconForegroundBrush}"
            Icon="IconLayoutColumns"
            StrokeWidth="2"
          />
          <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="Columns Altered" />
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource StatAddedBrush}"
              IsVisible="{Binding ColumnsAdded, Converter={StaticResource IntToBool}}"
              Text="{Binding ColumnsAdded, StringFormat='+{0}'}"
            />
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource StatRemovedBrush}"
              IsVisible="{Binding ColumnsRemoved, Converter={StaticResource IntToBool}}"
              Text="{Binding ColumnsRemoved, StringFormat='-{0}'}"
            />
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource StatChangedBrush}"
              IsVisible="{Binding ColumnsChanged, Converter={StaticResource IntToBool}}"
              Text="{Binding ColumnsChanged, StringFormat='~{0}'}"
            />
          </StackPanel>
        </StackPanel>
        <Button
          Grid.Column="1"
          Padding="8,4"
          Command="{Binding SaveColumnsAsTextCommand}"
          IsVisible="{Binding ColumnsHasContent}"
          ToolTip.Tip="Export Summary as text file"
        >
          <TextBlock FontSize="13" Text="Export Summary" />
        </Button>
      </Grid>
      <Grid Grid.Row="0" Grid.Column="2" Margin="0,0,0,4" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <ti:TablerIcon
            Width="18"
            Height="18"
            Brush="{DynamicResource IconForegroundBrush}"
            Icon="IconLayoutRows"
            StrokeWidth="2"
          />
          <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="Rows Altered" />
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource StatAddedBrush}"
              IsVisible="{Binding RowsAdded, Converter={StaticResource IntToBool}}"
              Text="{Binding RowsAdded, StringFormat='+{0}'}"
            />
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource StatRemovedBrush}"
              IsVisible="{Binding RowsRemoved, Converter={StaticResource IntToBool}}"
              Text="{Binding RowsRemoved, StringFormat='-{0}'}"
            />
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource StatChangedBrush}"
              IsVisible="{Binding RowsChanged, Converter={StaticResource IntToBool}}"
              Text="{Binding RowsChanged, StringFormat='~{0}'}"
            />
          </StackPanel>
        </StackPanel>
        <Button
          Grid.Column="1"
          Padding="8,4"
          Command="{Binding SaveRowsAsTextCommand}"
          IsVisible="{Binding RowsHasContent}"
          ToolTip.Tip="Export Summary as text file"
        >
          <TextBlock FontSize="13" Text="Export Summary" />
        </Button>
      </Grid>
      <Grid Grid.Row="0" Grid.Column="4" Margin="0,0,0,4" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <ti:TablerIcon
            Width="18"
            Height="18"
            Brush="{DynamicResource IconForegroundBrush}"
            Icon="IconPencil"
            StrokeWidth="2"
          />
          <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="Values" />
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource StatChangedBrush}"
              IsVisible="{Binding ValuesChanged, Converter={StaticResource IntToBool}}"
              Text="{Binding ValuesChanged, StringFormat='~{0}'}"
            />
            <TextBlock
              FontSize="13"
              FontWeight="SemiBold"
              Foreground="{DynamicResource StatAddedBrush}"
              IsVisible="{Binding ValuesNew, Converter={StaticResource IntToBool}}"
              Text="{Binding ValuesNew, StringFormat='+{0}'}"
            />
          </StackPanel>
        </StackPanel>
        <Button
          Grid.Column="1"
          Padding="8,4"
          Command="{Binding SaveValuesAsTextCommand}"
          IsVisible="{Binding ValuesHasContent}"
          ToolTip.Tip="Export Summary as text file"
        >
          <TextBlock FontSize="13" Text="Export Summary" />
        </Button>
      </Grid>

      <!--  Columns Panel  -->
      <Border
        Grid.Row="1"
        Grid.Column="0"
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource PanelBorderBrush}"
        BorderThickness="1"
      >
        <DataGrid
          x:Name="ColumnsGrid"
          Classes="diff"
          ConditionalFormattingModel="{Binding ColumnsFormatting}"
          ItemsSource="{Binding ColumnsView}"
          SearchModel="{Binding ColumnsSearch}"
        >
          <DataGrid.Columns>
            <DataGridTextColumn
              x:DataType="models:SchemaDiffRow"
              Width="Auto"
              Binding="{Binding Change}"
              Header="Change"
            />
            <DataGridTextColumn
              x:DataType="models:SchemaDiffRow"
              Width="Auto"
              Binding="{Binding Position}"
              Header="#"
            />
            <DataGridTextColumn
              x:DataType="models:SchemaDiffRow"
              Width="Auto"
              MinWidth="80"
              Binding="{Binding OldName}"
              Header="Source"
            />
            <DataGridTextColumn
              x:DataType="models:SchemaDiffRow"
              Width="Auto"
              MinWidth="80"
              Binding="{Binding NewName}"
              Header="Target"
            />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!--  Splitter 1  -->
      <GridSplitter
        Grid.Row="1"
        Grid.Column="1"
        Width="12"
        Background="Transparent"
        ResizeDirection="Columns"
      />
      <ti:TablerIcon
        Grid.Row="1"
        Grid.Column="1"
        Width="16"
        Height="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Brush="{DynamicResource IconForegroundBrush}"
        Icon="IconGripVertical"
        IsHitTestVisible="False"
        Opacity="0.3"
        StrokeWidth="2"
      />

      <!--  Rows Panel  -->
      <Border
        Grid.Row="1"
        Grid.Column="2"
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource PanelBorderBrush}"
        BorderThickness="1"
      >
        <DataGrid
          x:Name="RowsGrid"
          Classes="diff"
          ConditionalFormattingModel="{Binding RowsFormatting}"
          ItemsSource="{Binding RowsView}"
          SearchModel="{Binding RowsSearch}"
        >
          <DataGrid.Columns>
            <DataGridTextColumn
              x:DataType="models:SchemaDiffRow"
              Width="Auto"
              Binding="{Binding Change}"
              Header="Change"
            />
            <DataGridTextColumn
              x:DataType="models:SchemaDiffRow"
              Width="Auto"
              Binding="{Binding Position}"
              Header="#"
            />
            <DataGridTextColumn
              x:DataType="models:SchemaDiffRow"
              Width="Auto"
              MinWidth="80"
              Binding="{Binding OldName}"
              Header="Source"
            />
            <DataGridTextColumn
              x:DataType="models:SchemaDiffRow"
              Width="Auto"
              MinWidth="80"
              Binding="{Binding NewName}"
              Header="Target"
            />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!--  Splitter 2  -->
      <GridSplitter
        Grid.Row="1"
        Grid.Column="3"
        Width="12"
        Background="Transparent"
        ResizeDirection="Columns"
      />
      <ti:TablerIcon
        Grid.Row="1"
        Grid.Column="3"
        Width="16"
        Height="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Brush="{DynamicResource IconForegroundBrush}"
        Icon="IconGripVertical"
        IsHitTestVisible="False"
        Opacity="0.3"
        StrokeWidth="2"
      />

      <!--  Values Panel  -->
      <Border
        Grid.Row="1"
        Grid.Column="4"
        Background="{DynamicResource PanelBackgroundBrush}"
        BorderBrush="{DynamicResource PanelBorderBrush}"
        BorderThickness="1"
      >
        <DataGrid
          x:Name="ValuesGrid"
          Classes="diff"
          CanUserSortColumns="False"
          ItemsSource="{Binding ValuesView}"
          SearchModel="{Binding ValuesSearch}"
        >
          <DataGrid.Columns>
            <!--  Hidden so search also matches the row names shown in group headers  -->
            <DataGridTextColumn
              x:DataType="models:ValueDiffRow"
              Binding="{Binding RowLabel}"
              Header="Row"
              IsVisible="False"
            />
            <DataGridTextColumn
              x:DataType="models:ValueDiffRow"
              Width="Auto"
              Binding="{Binding Column}"
              Header="Column"
            />
            <DataGridTextColumn
              x:DataType="models:ValueDiffRow"
              Width="Auto"
              MinWidth="80"
              Binding="{Binding OldValue}"
              Header="Source"
            />
            <DataGridTextColumn
              x:DataType="models:ValueDiffRow"
              Width="Auto"
              MinWidth="80"
              Binding="{Binding NewValue}"
              Header="Target"
            />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!--  Loading Overlay  -->
      <Border
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="5"
        Background="#80000000"
        IsVisible="{Binding IsLoading}"
      >
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock HorizontalAlignment="Center" Foreground="White" Text="{Binding StatusText}" />
        </StackPanel>
      </Border>
    </Grid>
    <!--  Bottom Bar  -->
    <Grid Grid.Row="2" Margin="8,0,8,4" ColumnDefinitions="*,Auto">
      <!--  Update notification (left)  -->
      <StackPanel
        Grid.Column="0"
        VerticalAlignment="Center"
        IsVisible="{Binding HasPendingUpdate}"
        Orientation="Horizontal"
        Spacing="8"
      >
        <Button Command="{Binding ApplyUpdateCommand}" IsEnabled="{Binding !IsDownloadingUpdate}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ti:TablerIcon
              Width="14"
              Height="14"
              Brush="{DynamicResource StatAddedBrush}"
              Icon="IconDownload"
              StrokeWidth="2"
            />
            <TextBlock
              VerticalAlignment="Center"
              FontSize="13"
              Foreground="{DynamicResource StatAddedBrush}"
              Text="{Binding UpdateAvailableText}"
            />
          </StackPanel>
        </Button>
        <ProgressBar
          Width="120"
          Height="8"
          VerticalAlignment="Center"
          IsVisible="{Binding IsDownloadingUpdate}"
          Maximum="1.0"
          Minimum="0.0"
          Value="{Binding UpdateDownloadProgress}"
        />
        <TextBlock
          VerticalAlignment="Center"
          FontSize="12"
          Foreground="{DynamicResource MutedBrush}"
          IsVisible="{Binding IsDownloadingUpdate}"
          Text="{Binding UpdateStatusText}"
        />
        <Button
          Padding="2"
          Background="Transparent"
          BorderThickness="0"
          Command="{Binding DismissUpdateCommand}"
          IsEnabled="{Binding !IsDownloadingUpdate}"
          ToolTip.Tip="Dismiss"
        >
          <ti:TablerIcon Width="12" Height="12" Brush="Gray" Icon="IconX" StrokeWidth="2" />
        </Button>
      </StackPanel>

      <!--  Attribution (right)  -->
      <Button
        Grid.Column="1"
        Padding="4,2"
        Background="Transparent"
        BorderThickness="0"
        Command="{Binding OpenOriginalProjectCommand}"
      >
        <StackPanel Orientation="Horizontal" Spacing="4">
          <ti:TablerIcon
            Width="14"
            Height="14"
            Brush="{DynamicResource IconForegroundBrush}"
            Icon="IconBrandGithubFilled"
            StrokeWidth="2"
          />
          <TextBlock VerticalAlignment="Center" FontSize="13" Text="Original by locbones" />
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>
